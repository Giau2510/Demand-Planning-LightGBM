# /etc/demandforecast/app.env - configuration of the VPS instance (root:demandforecast, chmod 640).
# No secret is written here: the Google credential is a FILE referenced by path (outside the release folders).

# runtime data outside the code (database, models, backups, logs, reports)
DF_DATA_DIR=/var/lib/demandforecast/data
DF_LOGS_DIR=/var/lib/demandforecast/logs
DF_BACKUPS_DIR=/var/lib/demandforecast/backups
DF_REPORTS_DIR=/var/lib/demandforecast/reports
DF_STORAGE_CONFIG=/var/lib/demandforecast/storage.json

# the app listens on 127.0.0.1 only; the reverse proxy forwards the public domain to it
DF_PORT=8765
# public host name(s) of the reverse proxy, comma separated (Host / Origin allow-list)
DF_ALLOWED_HOSTS=forecast.example.com
DF_LOG_LEVEL=INFO

# BigQuery (read-only): service-account key file of a reader account, stored outside /opt/demandforecast,
# owner root:demandforecast, chmod 640. The in-app "Sign in with Google" keeps its token only in memory on Linux.
GOOGLE_APPLICATION_CREDENTIALS=/etc/demandforecast/bq-reader.json
