# Cấu hình môi trường tùy chọn (KHÔNG chứa secret).
# Sao chép file này thành  %LOCALAPPDATA%\DemandForecast\app.env  rồi sửa giá trị nếu cần.
# Optional environment overrides (NO secrets). Copy to %LOCALAPPDATA%\DemandForecast\app.env

# Cổng web (mặc định 8765) / web port
DF_PORT=8765

# Mức log: DEBUG | INFO | WARNING / log level
DF_LOG_LEVEL=INFO

# Chu kỳ scheduler kiểm tra lịch (giây) / scheduler tick (seconds)
DF_TICK_SECONDS=30

# Thư mục dữ liệu khác mặc định: đặt biến môi trường người dùng DF_DATA_DIR (không đặt ở đây).
# To move the data folder, set a user environment variable DF_DATA_DIR (not in this file).

# Mặc định chỉ nghe trên 127.0.0.1. KHÔNG mở ra mạng LAN nếu chưa đánh giá bảo mật.
# The app binds to 127.0.0.1 only. Do not expose it to the LAN without a security review.
