# runtime data / logs / backups on the project drive (never commit user data); anchored to the project root so
# source folders with the same name (backend/app/data, docs/data) stay versioned
/data/
/logs/
/backups/
/checkpoints/
# app reports folder (runtime output, machine-specific evidence)
/reports/
# databases (SQLite + WAL/SHM)
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
# business data files; the Excel templates are generated by scripts/build-package.ps1
*.xlsx
*.xls
*.csv
/templates/
# packages / build outputs (scripts/release.ps1, scripts/vps/build-vps-artifact.ps1)
*.zip
*.sha256
*.tar.gz
*.tgz
# personal tool settings
.claude/settings.local.json
